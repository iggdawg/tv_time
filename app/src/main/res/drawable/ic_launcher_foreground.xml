<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Shadow under TV -->
    <path
        android:pathData="M31,76 C31,74 77,74 77,76 C77,79 31,79 31,76 Z"
        android:fillColor="#55000000" />

    <!-- TV Stand Legs -->
    <path
        android:pathData="M37,71 L33,78 A1.5,1.5 0 0,0 35.5,79.5 L41,71 Z"
        android:fillColor="#D49A00" />
    <path
        android:pathData="M71,71 L75,78 A1.5,1.5 0 0,0 72.5,79.5 L67,71 Z"
        android:fillColor="#D49A00" />

    <!-- Antennas -->
    <path
        android:pathData="M54,31 L43,19"
        android:strokeWidth="2.5"
        android:strokeColor="#FFCC00"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,19 A1.8,1.8 0 1,0 43,18.9 Z"
        android:fillColor="#FFE066" />

    <path
        android:pathData="M54,31 L65,19"
        android:strokeWidth="2.5"
        android:strokeColor="#FFCC00"
        android:strokeLineCap="round" />
    <path
        android:pathData="M65,19 A1.8,1.8 0 1,0 65,18.9 Z"
        android:fillColor="#FFE066" />

    <!-- Antenna Center Base -->
    <path
        android:pathData="M51.5,31.5 C51.5,30 56.5,30 56.5,31.5 Z"
        android:fillColor="#D49A00" />

    <!-- TV Body Frame with Material Gradient -->
    <path
        android:pathData="M35,30 L73,30 A9,9 0 0,1 82,39 L82,63 A9,9 0 0,1 73,72 L35,72 A9,9 0 0,1 26,63 L26,39 A9,9 0 0,1 35,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="30"
                android:endX="54"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE266" />
                <item android:offset="0.4" android:color="#FFCC00" />
                <item android:offset="1.0" android:color="#E0A000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Frame Bevel Highlight -->
    <path
        android:pathData="M35,31 L73,31 A8,8 0 0,1 81,39 L81,40 A8,8 0 0,0 73,32 L35,32 A8,8 0 0,0 27,40 L27,39 A8,8 0 0,1 35,31 Z"
        android:fillColor="#80FFFFFF" />

    <!-- Screen Bezel (Dark Inset) -->
    <path
        android:pathData="M33,34 L69,34 A5,5 0 0,1 74,39 L74,63 A5,5 0 0,1 69,68 L33,68 A5,5 0 0,1 28,63 L28,39 A5,5 0 0,1 33,34 Z"
        android:fillColor="#0D0F17" />

    <!-- Screen Glass Gradient -->
    <path
        android:pathData="M34,35.5 L68,35.5 A4,4 0 0,1 72,39.5 L72,62.5 A4,4 0 0,1 68,66.5 L34,66.5 A4,4 0 0,1 30,62.5 L30,39.5 A4,4 0 0,1 34,35.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="35.5"
                android:endX="72"
                android:endY="66.5"
                android:type="linear">
                <item android:offset="0.0" android:color="#1C2130" />
                <item android:offset="1.0" android:color="#10131C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Screen Glass Reflection (Diagonal) -->
    <path
        android:pathData="M30,50 L45,35.5 L55,35.5 L30,60 Z"
        android:fillColor="#0CFFFFFF" />

    <!-- "Time" Clock Dial Inside Screen (Center: 51, 51) -->
    <!-- Clock Outer Dial Ring -->
    <path
        android:pathData="M51,39 A12,12 0 1,0 51.01,39 Z"
        android:strokeWidth="2.2"
        android:strokeColor="#FFCC00"
        android:fillColor="#00000000" />

    <!-- Clock Hour Marks (12, 3, 6, 9) -->
    <path
        android:pathData="M51,40 L51,42 M51,60 L51,62 M40,51 L42,51 M60,51 L62,51"
        android:strokeWidth="1.6"
        android:strokeColor="#FFE580"
        android:strokeLineCap="round" />

    <!-- Clock Hour Hand (pointing up at 12) -->
    <path
        android:pathData="M51,51 L51,43.5"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Clock Minute Hand (pointing right at 3) -->
    <path
        android:pathData="M51,51 L57,51"
        android:strokeWidth="2.2"
        android:strokeColor="#FFCC00"
        android:strokeLineCap="round" />

    <!-- Center Clock Pivot -->
    <path
        android:pathData="M51,51 A1.8,1.8 0 1,0 51.01,51 Z"
        android:fillColor="#FFFFFF" />

    <!-- Controls Panel on Right Side of TV -->
    <!-- Top Knob -->
    <path
        android:pathData="M77.5,41 A2,2 0 1,0 77.51,41 Z"
        android:fillColor="#10131C" />
    <path
        android:pathData="M77.5,41 A1.2,1.2 0 1,0 77.51,41 Z"
        android:fillColor="#FFCC00" />

    <!-- Bottom Knob -->
    <path
        android:pathData="M77.5,47.5 A2,2 0 1,0 77.51,47.5 Z"
        android:fillColor="#10131C" />
    <path
        android:pathData="M77.5,47.5 A1.2,1.2 0 1,0 77.51,47.5 Z"
        android:fillColor="#FFCC00" />

    <!-- Speaker Slits -->
    <path
        android:pathData="M76,55 L79,55 M76,58 L79,58 M76,61 L79,61"
        android:strokeWidth="1"
        android:strokeColor="#D49A00"
        android:strokeLineCap="round" />

</vector>
